{
  "expo": {
    "name": "Liggo",
    "slug": "liggo",
    "version": "1.2.0",
    "scheme": "liggo",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F9F9F9",
    "icon": "./assets/logo.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.liggo.mobile"
    },
    "android": {
      "package": "app.liggo.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 160,
          "backgroundColor": "#F9F9F9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
