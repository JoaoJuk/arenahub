DATABASE_URL="file:./dev.db"
# Obrigatório em produção (mínimo 32 caracteres — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET="troque-este-segredo-em-producao"
# Validade do login (padrão 7 dias)
JWT_EXPIRES="7d"
PORT=3333
# URL pública da API (usada nos links de pagamento dividido)
BASE_URL="http://localhost:3333"
# Deixe vazio para modo simulado; preencha para cobranças reais.
# ATENÇÃO: em produção (NODE_ENV=production) o modo simulado é bloqueado.
MP_ACCESS_TOKEN=""
# Em produção: NODE_ENV=production
NODE_ENV="development"
# Em produção: origens permitidas separadas por vírgula (ex.: https://app.liggo.app)
CORS_ORIGINS=""
# Fuso horário usado no cálculo de horários disponíveis
TZ_APP="America/Sao_Paulo"
# Verificação de e-mail/celular no cadastro. Vazios = modo dev (código aparece na tela).
# Em produção configure um provedor (ex.: Resend/SendGrid e Twilio/Zenvia).
EMAIL_API_KEY=""
SMS_API_KEY=""
